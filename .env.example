# NASA EONET API Base URL
EONET_API_BASE_URL=https://eonet.gsfc.nasa.gov/api/v3

# Cache revalidation time in seconds (default: 300)
EONET_FETCH_REVALIDATE_SECONDS=300

# Mapbox Access Token (Optional but recommended for premium maps)
# Get yours at https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
