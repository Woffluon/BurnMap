# NASA FIRMS MAP_KEY (server-only)
# Request one at https://firms.modaps.eosdis.nasa.gov/api/
NASA_FIRMS_MAP_KEY=your_firms_map_key_here

# NASA FIRMS API Base URL
FIRMS_API_BASE_URL=https://firms.modaps.eosdis.nasa.gov

# Mapbox Access Token (Optional but recommended for premium maps)
# Get yours at https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
